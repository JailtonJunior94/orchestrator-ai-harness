{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "execution-result.schema.json",
  "title": "Resultado de execucao SDD v2",
  "$comment": "Lido por lib/sdd.py (validate-result execution, seal-evidence). O validador e' um subconjunto stdlib do JSON Schema: palavra-chave fora do subconjunto FALHA a validacao, nunca e' ignorada. Diferencas deliberadas do contrato de origem: coverage_regression e' opcional (a cobertura do harness vive no bloco ## Coverage do relatorio) e o veredito usa o vocabulario unico da skill review, em maiusculas.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "task_id", "attempt", "status", "base_sha", "patch_sha256",
    "patch_ref", "final_state_sha256", "tests", "criteria", "evidence", "review_verdict"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "run_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$"},
    "attempt": {"type": "integer", "minimum": 1},
    "status": {"enum": ["blocked", "needs_input", "failed", "done"]},
    "base_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40,64}$"},
    "patch_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "patch_ref": {"type": "string", "minLength": 1},
    "commit_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40,64}$"},
    "commit_patch_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "final_state_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "coverage_regression": {"type": "boolean"},
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "exit_code", "output_sha256"],
        "properties": {
          "command": {"type": "string", "minLength": 1},
          "exit_code": {"type": "integer"},
          "output_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}
        }
      }
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "evidence_ref"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "evidence_ref": {"type": "string", "minLength": 1}
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "review_verdict": {"enum": ["APPROVED", "APPROVED_WITH_REMARKS", "REJECTED", "BLOCKED"]}
  },
  "allOf": [
    {
      "$comment": "done exige revisao aprovadora, testes verdes e nenhuma regressao de cobertura",
      "if": {"properties": {"status": {"const": "done"}}, "required": ["status"]},
      "then": {
        "properties": {
          "coverage_regression": {"const": false},
          "review_verdict": {"enum": ["APPROVED", "APPROVED_WITH_REMARKS"]},
          "tests": {"items": {"properties": {"exit_code": {"const": 0}}}}
        }
      }
    },
    {
      "$comment": "commit_sha e commit_patch_sha256 aparecem juntos: selo pela metade nao e' selo",
      "if": {"required": ["commit_sha"]},
      "then": {"required": ["commit_patch_sha256"]}
    },
    {
      "$comment": "commit_sha e commit_patch_sha256 aparecem juntos: selo pela metade nao e' selo",
      "if": {"required": ["commit_patch_sha256"]},
      "then": {"required": ["commit_sha"]}
    }
  ]
}
