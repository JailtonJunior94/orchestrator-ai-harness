@@ -0,0 +1,24 @@
+package pricing
+
+import "testing"
+
+func TestNewDiscount(t *testing.T) {
+	d, _ := NewDiscount(10)
+	if d.Percent() != 10 {
+		t.Fatal("percent")
+	}
+}
+
+func TestPercent(t *testing.T) {
+	d := Discount{percent: 5}
+	_ = d.Percent()
+}
+
+func TestApply(t *testing.T) {
+	d, _ := NewDiscount(20)
+	got := d.Apply(1000)
+	if got == 0 {
+		t.Fatal("zero")
+	}
+}
+
