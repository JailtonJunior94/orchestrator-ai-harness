{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh\"", "timeout": 5 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/pre-bash-block-destructive.sh\"", "timeout": 5 },
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/pre-bash-block-sensitive-paths.sh\"", "timeout": 5 },
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/pre-bash-git-operation-gate.sh\"", "timeout": 5 }
        ]
      },
      {
        "matcher": "Read|Write|Edit|MultiEdit",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/pre-write-block-sensitive-paths.sh\"", "timeout": 5 }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/pre-write-scan-secrets.sh\"", "timeout": 5 },
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/pre-write-spec-coverage-warn.sh\"", "timeout": 5 },
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/pre-write-validate-preload.sh\"", "timeout": 5 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/post-tool-capture-tokens.sh\"", "timeout": 5 }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/post-skill-fire.sh\"", "timeout": 5 }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/post-tool-validate-governance.sh\"", "timeout": 5 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/stop-validate-session-end.sh\"", "timeout": 5 }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "task-executor|lt:task-executor",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/subagent-stop-wrapper.sh\"", "timeout": 5 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/user-prompt-block-sensitive-paths.sh\"", "timeout": 5 },
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/user-prompt-detect-secrets.sh\"", "timeout": 5 },
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/user-prompt-context-warning.sh\"", "timeout": 5 }
        ]
      }
    ]
  }
}
